)
(rule
    ((= ?kind (KernelAdd ?shape ?a_strides ?b_strides ?out_strides (Int)))
     (= ?__cuda_elems (n_elements ?shape)))
    ((cuda_output_bytes ?kind (MCeilDiv (MMul ?__cuda_elems (MNum 32)) (MNum 8))))
