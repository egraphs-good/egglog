;; A primitive target must be partially applied enough to match the inferred
;; unary function sort: no partial argument was supplied to make binary `+` unary.

(sort I64Add (UnstableFn (i64 i64) i64))
(sort F64Add (UnstableFn (f64 f64) f64))
(sort I64ToI64 (UnstableFn (i64) i64))
(sort F64ToF64 (UnstableFn (f64) f64))

(check (= (unstable-app (unstable-fn "+") 2) 3))
