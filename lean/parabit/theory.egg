; Modular integer IR from ParaBit (CAV 2026). Bw p x denotes x mod 2^p.
(datatype Expr
  (Var String) (Num i64) (Bw Expr Expr) (Signed Expr Expr)
  (Add Expr Expr) (Sub Expr Expr) (Mul Expr Expr) (Neg Expr)
  (Div Expr Expr) (Pow Expr Expr) (Shl Expr Expr) (Shr Expr Expr)
  (And Expr Expr) (Or Expr Expr) (Xor Expr Expr) (Not Expr)
  (Sel Expr Expr Expr))

; The input adapter asserts width only for a positive width assumption in
; the problem. Precision also tracks widths of newly constructed expressions.
(relation atom-index (Expr i64))
(relation width (Expr))
(relation precision (Expr))
(relation lt (Expr Expr))
(relation le (Expr Expr))
(relation nonneg (Expr))
(relation fits (Expr Expr))
(relation sign-fits (Expr Expr))
(function constant (Expr) i64 :no-merge)

(rule ((= e (Num n))) ((set (constant e) n)))
(rule ((= n (constant e))) ((union e (Num n))))
(rule ((= e (Bw p x))) ((precision p) (fits e p) (nonneg e)))
(rule ((= e (Signed p x))) ((precision p)))
(rule ((width p)) ((precision p) (lt (Num 0) p) (le (Num 1) p)))
(rule ((precision p)) ((le p p)))
(rule ((lt a b)) ((le a b)))
(rule ((le a b) (le b c)) ((le a c)))
(rule ((lt a b) (le b c)) ((lt a c)))
(rule ((le a b) (lt b c)) ((lt a c)))
(rule ((= a (Num i)) (= b (Num j)) (< i j)) ((lt a b)))
(rule ((= a (Num i)) (>= i 0)) ((nonneg a)))
(rule ((le (Num 0) a)) ((nonneg a)))
(rule ((le (Num 1) p) (precision p)) ((width p)))
(rule ((= sum (Add a b)) (nonneg b)) ((le a sum)))
(rule ((= sum (Add a b)) (lt (Num 0) b)) ((lt a sum)))
(rule ((= diff (Sub a b)) (nonneg b)) ((le diff a)))
(rule ((= diff (Sub a b)) (lt (Num 0) b)) ((lt diff a)))

; Unsigned precision lattice. fits x w means 0 <= x < 2^w. Bounds are
; propagated only onto widths appearing in terms or in supplied comparisons.
(rule ((fits x p) (le p q)) ((fits x q)))
(rule ((width p)) ((fits (Num 0) p) (fits (Num 1) p)))
(rule ((fits x p)) ((nonneg x)))
(rule ((= e (Bw p x)) (fits x p)) ((union e x)))
(rule ((= e (Bw p (Bw q x))) (le p q)) ((union e (Bw p x))))
(rewrite (Bw p (Bw p x)) (Bw p x))
(rewrite (Bw p (Num 0)) (Num 0))
(rule ((= e (Add a b)) (fits a p) (fits b q) (lt p w) (lt q w)) ((fits e w)))
(rule ((= e (Mul a b)) (fits a p) (fits b q) (le (Add p q) w)) ((fits e w)))
(rule ((= e (Mul a b)) (fits a p) (fits b (Num 1))) ((fits e p)))
(rule ((= e (And a b)) (fits a p)) ((fits e p)))
(rule ((= e (Or a b)) (fits a p) (fits b p)) ((fits e p)))
(rule ((= e (Xor a b)) (fits a p) (fits b p)) ((fits e p)))
(rule ((= e (Shr a b)) (fits a p) (nonneg b)) ((fits e p)))
(rule ((= e (Sel c a b)) (fits a p) (fits b p)) ((fits e p)))

; Signed precision. sign-fits x p means -2^(p-1) <= x < 2^(p-1), p > 0.
(rule ((= e (Signed p x)) (width p)) ((sign-fits e p)))
(rule ((fits x p) (lt p q) (width q)) ((sign-fits x q)))
(rule ((sign-fits x p) (le p q)) ((sign-fits x q)))
(rule ((= e (Signed p x)) (sign-fits x p)) ((union e x)))
(rule ((= e (Neg a)) (fits a p) (lt p q) (width q)) ((sign-fits e q)))
(rewrite (Signed p (Bw p x)) (Signed p x))
(rewrite (Bw p (Signed p x)) (Bw p x))
(rule ((= e (Bw p (Signed q x))) (le p q)) ((union e (Bw p x))))

; Constant-fold over mathematical integers. An overflowing intermediate
; causes its checked comparison to fail, leaving that fact undiscovered.
(rule ((= e (Add a b)) (= i (constant a)) (= j (constant b))
       (<= (+ i j) 9223372036854775807)) ((set (constant e) (+ i j))))
(rule ((= e (Sub a b)) (= i (constant a)) (= j (constant b))
       (<= (- i j) 9223372036854775807)) ((set (constant e) (- i j))))
(rule ((= e (Mul a b)) (= i (constant a)) (= j (constant b))
       (<= (* i j) 9223372036854775807)) ((set (constant e) (* i j))))
(rule ((= e (Neg a)) (= i (constant a)) (> i -9223372036854775808)) ((set (constant e) (- 0 i))))
(rule ((= e (Not a)) (= i (constant a))) ((set (constant e) (^ i -1))))
(rule ((= e (And a b)) (= i (constant a)) (= j (constant b))) ((set (constant e) (& i j))))
(rule ((= e (Or a b)) (= i (constant a)) (= j (constant b))) ((set (constant e) (| i j))))
(rule ((= e (Xor a b)) (= i (constant a)) (= j (constant b))) ((set (constant e) (^ i j))))
(rule ((= e (Bw p a)) (= w (constant p)) (= i (constant a)) (>= w 0) (< w 63))
      ((set (constant e) (& i (- (<< 1 w) 1)))))
(rule ((= e (Bw p a)) (= w (constant p)) (= i (constant a)) (>= w 63) (>= i 0))
      ((set (constant e) i)))
(rule ((= e (Pow (Num 2) p)) (= w (constant p)) (>= w 0) (< w 63)) ((set (constant e) (<< 1 w))))
(rule ((= e (Div a b)) (= i (constant a)) (= j (constant b)) (>= i 0) (> j 0))
      ((set (constant e) (/ i j))))
(rule ((= e (Shr a b)) (= i (constant a)) (= j (constant b)) (>= j 0) (< j 64))
      ((set (constant e) (>> i j))))

(rule ((= e (Bw p a)) (= w (constant p)) (= i (constant a)) (<= w 0))
      ((set (constant e) 0)))
(rule ((= e (Bw (Num 63) a)) (= i (constant a)))
      ((set (constant e) (& i 9223372036854775807))))
(rule ((= e (Signed p a)) (= w (constant p)) (= i (constant a)) (<= w 0))
      ((set (constant e) 0)))
(rule ((= e (Signed p a)) (= w (constant p)) (= i (constant a)) (>= w 1) (< w 63))
      ((set (constant e) (- (^ (& i (- (<< 1 w) 1)) (<< 1 (- w 1))) (<< 1 (- w 1))))))
(rule ((= e (Signed (Num 63) a)) (= i (constant a)))
      ((set (constant e) (- (^ (& i 9223372036854775807) 4611686018427387904) 4611686018427387904))))
(rule ((= e (Signed p a)) (= w (constant p)) (= i (constant a)) (>= w 64))
      ((set (constant e) i)))
(rule ((= e (Shl a b)) (= i (constant a)) (= j (constant b)) (>= j 0) (< j 63)
       (<= (* i (<< 1 j)) 9223372036854775807))
      ((set (constant e) (* i (<< 1 j)))))
(rule ((= value (Num i)) (= w (constant p)) (precision p) (>= i 0) (>= w 0) (< w 63)
       (< i (<< 1 w))) ((fits value p)))
(rule ((= value (Num i)) (= w (constant p)) (precision p) (>= i 0) (>= w 63))
      ((fits value p)))

; Reduction rules common to the integer ring and infinite two's-complement
; bitwise operations. Keep expansions out of this first ruleset.
(rewrite (Add a b) (Add b a))
(rewrite (Mul a b) (Mul b a))
(rewrite (And a b) (And b a))
(rewrite (Or a b) (Or b a))
(rewrite (Xor a b) (Xor b a))
(rewrite (Add (Num 0) a) a)
(rewrite (Mul (Num 1) a) a)
(rewrite (Mul (Num 0) a) (Num 0))
(rewrite (Sub a a) (Num 0))
(rewrite (Sub a (Num 0)) a)
(rewrite (Sub (Num 0) a) (Neg a))
(rewrite (Neg (Neg a)) a)
(rewrite (Add a (Neg a)) (Num 0))
(rewrite (Add (Sub a b) b) a)
(rewrite (Sub (Add a b) b) a)
(rewrite (Div a (Num 1)) a)
(rewrite (Shl a (Num 0)) a)
(rewrite (Shr a (Num 0)) a)
(rewrite (And a a) a)
(rewrite (Or a a) a)
(rewrite (Xor a a) (Num 0))
(rewrite (And a (Num 0)) (Num 0))
(rewrite (Or a (Num 0)) a)
(rewrite (Xor a (Num 0)) a)
(rewrite (And a (Num -1)) a)
(rewrite (Or a (Num -1)) (Num -1))
(rewrite (Xor a (Num -1)) (Not a))
(rewrite (Not (Not a)) a)
(rewrite (And a (Not a)) (Num 0))
(rewrite (Or a (Not a)) (Num -1))
(rewrite (Xor a (Not a)) (Num -1))
(rewrite (Or a (And a b)) a)
(rewrite (And a (Or a b)) a)
(rewrite (Xor a (Xor a b)) b)
(rewrite (Sel c a a) a)
(rewrite (Sel (Num 0) a b) b)
(rewrite (Sel (Num 1) a b) a)
(rule ((= e (Sel c (Num 1) (Num 0))) (fits c (Num 1))) ((union e c)))
(rewrite (Bw p (Sel c a b)) (Sel c (Bw p a) (Bw p b)))

; In each ring/bitwise operator the low p bits depend only on the low p
; bits of the operands. This removes interior reductions, including after
; a width-order fact arrives in a later saturation round.
(rule ((= e (Bw p (Add (Bw q a) b))) (le p q)) ((union e (Bw p (Add a b)))))
(rule ((= e (Bw p (Mul (Bw q a) b))) (le p q)) ((union e (Bw p (Mul a b)))))
(rule ((= e (Bw p (Sub (Bw q a) b))) (le p q)) ((union e (Bw p (Sub a b)))))
(rule ((= e (Bw p (Sub b (Bw q a)))) (le p q)) ((union e (Bw p (Sub b a)))))
(rule ((= e (Bw p (And (Bw q a) b))) (le p q)) ((union e (Bw p (And a b)))))
(rule ((= e (Bw p (Or (Bw q a) b))) (le p q)) ((union e (Bw p (Or a b)))))
(rule ((= e (Bw p (Xor (Bw q a) b))) (le p q)) ((union e (Bw p (Xor a b)))))
(rule ((= e (Bw p (Shl (Bw q a) b))) (le p q)) ((union e (Bw p (Shl a b)))))
(rule ((= e (Bw p (Neg (Bw q a)))) (le p q)) ((union e (Bw p (Neg a)))))
(rule ((= e (Bw p (Not (Bw q a)))) (le p q)) ((union e (Bw p (Not a)))))

; Relational reduced ordered decision diagrams for word-wise Boolean formulas.
; A basis word contributes one independent Boolean at an arbitrary bit position.
; Width truncation is AND with its symbolic low-bit mask. Canonical results
; therefore establish equality at every bit, for all widths and source values.
(ruleset bdd)
(datatype Diagram (DFalse) (DTrue) (DNode i64 Diagram Diagram))
(datatype Gate (GAnd) (GOr) (GXor))
(relation diagram-of (Expr Diagram))
(function representative (Expr) Diagram :merge old)
(function word-with-diagram (Diagram) Expr :merge old)
; Detect accidental reuse of one atom number for two unrelated words.
(function basis (i64) Expr :no-merge)
(rule ((atom-index x i)) ((set (basis i) x)) :ruleset bdd)
(rule ((atom-index x i) (< i 9223372036854775807))
      ((diagram-of x (DNode i (DFalse) (DTrue)))) :ruleset bdd)
(rule ((= x (Num 0))) ((diagram-of x (DFalse))) :ruleset bdd)
(rule ((= x (Num -1))) ((diagram-of x (DTrue))) :ruleset bdd)
(rule ((diagram-of x d))
      ((set (representative x) d) (set (word-with-diagram d) x)) :ruleset bdd)
(rule ((diagram-of x d) (= y (word-with-diagram d))) ((union x y)) :ruleset bdd)

; A pending gate is keyed by its two already canonical arguments. The
; combine relation is also the memo table shared by all word expressions.
(relation demand (Gate Diagram Diagram))
(function combine (Gate Diagram Diagram) Diagram :no-merge)
(relation pending (Expr Gate Diagram Diagram))
(rule ((= e (And x y)) (= a (representative x)) (= b (representative y)))
      ((pending e (GAnd) a b)) :ruleset bdd)
(rule ((= e (Or x y)) (= a (representative x)) (= b (representative y)))
      ((pending e (GOr) a b)) :ruleset bdd)
(rule ((= e (Xor x y)) (= a (representative x)) (= b (representative y)))
      ((pending e (GXor) a b)) :ruleset bdd)
(rule ((= e (Not x)) (= a (representative x)))
      ((pending e (GXor) a (DTrue))) :ruleset bdd)
(rule ((= e (Bw p x)) (= mask (representative (Bw p (Num -1)))) (= a (representative x)))
      ((pending e (GAnd) a mask)) :ruleset bdd)
(rule ((pending e g a b)) ((demand g a b)) :ruleset bdd)
(rule ((pending e g a b) (= r (combine g a b))) ((diagram-of e r)) :ruleset bdd)

(set (combine (GAnd) (DFalse) (DFalse)) (DFalse))
(set (combine (GAnd) (DFalse) (DTrue)) (DFalse))
(set (combine (GAnd) (DTrue) (DFalse)) (DFalse))
(set (combine (GAnd) (DTrue) (DTrue)) (DTrue))
(set (combine (GOr) (DFalse) (DFalse)) (DFalse))
(set (combine (GOr) (DFalse) (DTrue)) (DTrue))
(set (combine (GOr) (DTrue) (DFalse)) (DTrue))
(set (combine (GOr) (DTrue) (DTrue)) (DTrue))
(set (combine (GXor) (DFalse) (DFalse)) (DFalse))
(set (combine (GXor) (DFalse) (DTrue)) (DTrue))
(set (combine (GXor) (DTrue) (DFalse)) (DTrue))
(set (combine (GXor) (DTrue) (DTrue)) (DFalse))

(function level (Diagram) i64 :no-merge)
(set (level (DFalse)) 9223372036854775807)
(set (level (DTrue)) 9223372036854775807)
(rule ((= x (DNode i l h))) ((set (level x) i)) :ruleset bdd)
(relation split (Gate Diagram Diagram i64 Diagram Diagram Diagram Diagram))
(rule ((demand g x y) (= x (DNode i l h)) (= y (DNode i u v)))
      ((split g x y i l u h v)) :ruleset bdd)
(rule ((demand g x y) (= x (DNode i l h)) (= j (level y)) (< i j))
      ((split g x y i l y h y)) :ruleset bdd)
(rule ((demand g x y) (= y (DNode j u v)) (= i (level x)) (< j i))
      ((split g x y j x u x v)) :ruleset bdd)
(rule ((split g x y i a b c d))
      ((demand g a b) (demand g c d)) :ruleset bdd)
(rule ((split g x y i a b c d) (= r (combine g a b)) (= r (combine g c d)))
      ((set (combine g x y) r)) :ruleset bdd)
(rule ((split g x y i a b c d) (= l (combine g a b)) (= h (combine g c d)) (!= l h))
      ((set (combine g x y) (DNode i l h))) :ruleset bdd)

; Expose arithmetic and multiplexor structure. These are ordinary modular
; integer identities; join guards use the same inferred widths as above.
(rewrite (Sub a b) (Add a (Neg b)))
(rewrite (Neg (Add a b)) (Add (Neg a) (Neg b)))
(rewrite (Neg (Sub a b)) (Sub b a))
(rewrite (Mul (Neg a) (Neg b)) (Mul a b))
(rewrite (Mul (Num -1) a) (Neg a))
(rewrite (Add a a) (Mul (Num 2) a))
(rewrite (Sub (Mul (Num 2) a) a) a)
(rewrite (Add a (Add b (Neg a))) b)
(rewrite (Add (Num 1) (Not a)) (Neg a))
(rewrite (Not a) (Sub (Num -1) a))
(rewrite (Bw p (Xor a (Bw p (Num -1)))) (Bw p (Not a)))
(rewrite (Add (And a b) (Xor a b)) (Or a b))
(rewrite (Sub (Or a b) (Xor a b)) (And a b))
(rewrite (Shl a b) (Mul a (Pow (Num 2) b)))
(rewrite (Shr a b) (Div a (Pow (Num 2) b)))
(rewrite (Pow a (Num 0)) (Num 1))
(rewrite (Pow a (Num 1)) a)
(rule ((= e (Mul (Pow a b) (Pow a c))) (nonneg b) (nonneg c))
      ((union e (Pow a (Add b c)))))
(rule ((= e (Div (Div a (Pow (Num 2) b)) (Pow (Num 2) c))) (nonneg b) (nonneg c))
      ((union e (Div a (Pow (Num 2) (Add b c))))))
(rewrite (Signed w (Sel c a b)) (Sel c (Signed w a) (Signed w b)))
(rewrite (Sel c (Sel c x y) z) (Sel c x z))
(rewrite (Sel c x (Sel c y z)) (Sel c x z))
(rewrite (Sub (Sel c a b) (Sel c d e)) (Sel c (Sub a d) (Sub b e)))
(rewrite (Add (Sel c a b) (Sel c d e)) (Sel c (Add a d) (Add b e)))
(rewrite (Mul (Sel c a b) (Sel c d e)) (Sel c (Mul a d) (Mul b e)))
(rewrite (Or x (Sel c a b)) (Sel c (Or x a) (Or x b)))
(rewrite (Xor x (Sel c a b)) (Sel c (Xor x a) (Xor x b)))
(rewrite (And x (Sel c a b)) (Sel c (And x a) (And x b)))
(rewrite (Mul x (Sel c a (Num 0))) (Sel c (Mul x a) (Num 0)))
(rewrite (Mul x (Sel c (Num 0) a)) (Sel c (Num 0) (Mul x a)))
(rule ((= e (Bw p (Add (Signed q a) b))) (le p q)) ((union e (Bw p (Add a b)))))
(rule ((= e (Bw p (Mul (Signed q a) b))) (le p q)) ((union e (Bw p (Mul a b)))))
(rule ((= e (Bw p (Sub (Signed q a) b))) (le p q)) ((union e (Bw p (Sub a b)))))
(rule ((= e (Bw p (Sub b (Signed q a)))) (le p q)) ((union e (Bw p (Sub b a)))))
(rule ((= e (Bw p (And (Signed q a) b))) (le p q)) ((union e (Bw p (And a b)))))
(rule ((= e (Bw p (Or (Signed q a) b))) (le p q)) ((union e (Bw p (Or a b)))))
(rule ((= e (Bw p (Xor (Signed q a) b))) (le p q)) ((union e (Bw p (Xor a b)))))
(rule ((= e (Bw p (Shl (Signed q a) b))) (le p q)) ((union e (Bw p (Shl a b)))))

; Reassociation and distributivity can enumerate many intermediate trees.
; Isolate them so the cheap phases can stop first.
(ruleset algebra)
(rewrite (Add (Add a b) c) (Add a (Add b c)) :ruleset algebra)
(rewrite (Mul (Mul a b) c) (Mul a (Mul b c)) :ruleset algebra)
(rewrite (Mul a (Add b c)) (Add (Mul a b) (Mul a c)) :ruleset algebra)
(rewrite (Mul a (Sub b c)) (Sub (Mul a b) (Mul a c)) :ruleset algebra)
(rewrite (Mul a (Neg b)) (Neg (Mul a b)) :ruleset algebra)

; A shift is scaled integer multiplication or Euclidean division. The maximal
; unsigned shift amount with u bits is 2^u - 1.
(rule ((= e (Shl a b)) (fits a p) (fits b u)
       (le (Add p (Sub (Pow (Num 2) u) (Num 1))) s)) ((fits e s)))
(rule ((= e (Pow (Num 2) b))) ((lt (Num 0) e)))
(rule ((= e (Div (Add a (Mul x b)) b)) (lt (Num 0) b))
      ((union e (Add (Div a b) x))))
(rule ((= e (Bw p (Shr (Bw q a) b))) (le b (Sub q p)) (nonneg b))
      ((union e (Bw p (Shr a b)))))
(rewrite (Shr (Add a (Num 1)) (Num 1)) (Add (Shr a (Num 1)) (Bw (Num 1) a)))

; Bitwise operations commute with sign extension because each output bit
; copies the corresponding input bit, or the shared sign-bit position.
(rewrite (And (Signed p x) (Signed p y)) (Signed p (And x y)))
(rewrite (Or (Signed p x) (Signed p y)) (Signed p (Or x y)))
(rewrite (Xor (Signed p x) (Signed p y)) (Signed p (Xor x y)))
(rewrite (Signed (Num 1) x) (Neg (Bw (Num 1) x)))
(rule ((= e (And (Neg b) x)) (fits b (Num 1))) ((union e (Sel b x (Num 0)))))
(rewrite (Sel c (Add a (Num 1)) a) (Add a (Bw (Num 1) c)))

; The two operand widths in a difference need not be comparable. It suffices
; that each fits strictly below the destination's sign bit.
(rule ((= e (Sub a b)) (fits a p) (fits b q) (lt p r) (lt q r) (width r))
      ((sign-fits e r)))

; Selecting between a modular base and its increment conditionally adds the
; increment. The selector's least significant bit supplies the multiplier.
(rewrite (Sel c (Bw p (Add a b)) (Bw p a))
         (Bw p (Add a (Mul (Bw (Num 1) c) b))))
; An integer complement and an additive inverse differ by one. Expose the
; complement to the Boolean analysis where the inverse has a bitwise operand.
(rewrite (Neg (Or a b)) (Add (Not (Or a b)) (Num 1)))
(rewrite (Neg (And a b)) (Add (Not (And a b)) (Num 1)))
(rewrite (Neg (Xor a b)) (Add (Not (Xor a b)) (Num 1)))

; Six independent basis bits fit in the lanes of a native 64-bit truth table.
; A word without a representable formula has no entry. Larger supports can
; still use diagrams. Each rank denotes the same basis word across all lanes.
(ruleset truth-table)
(relation word-table (Expr i64))
(function lanes (Expr) i64 :merge old)
(function word-with-table (i64) Expr :merge old)
(rule ((atom-index x i)) ((set (basis i) x)) :ruleset truth-table)
(rule ((atom-index x 0)) ((word-table x -6148914691236517206)) :ruleset truth-table)
(rule ((atom-index x 1)) ((word-table x -3689348814741910324)) :ruleset truth-table)
(rule ((atom-index x 2)) ((word-table x -1085102592571150096)) :ruleset truth-table)
(rule ((atom-index x 3)) ((word-table x -71777214294589696)) :ruleset truth-table)
(rule ((atom-index x 4)) ((word-table x -281470681808896)) :ruleset truth-table)
(rule ((atom-index x 5)) ((word-table x -4294967296)) :ruleset truth-table)
(rule ((= x (Num 0))) ((word-table x 0)) :ruleset truth-table)
(rule ((= x (Num -1))) ((word-table x -1)) :ruleset truth-table)
(rule ((word-table x i))
      ((set (lanes x) i) (set (word-with-table i) x)) :ruleset truth-table)
(rule ((word-table x i) (= y (word-with-table i))) ((union x y)) :ruleset truth-table)
(rule ((= e (And x y)) (= a (lanes x)) (= b (lanes y)))
      ((word-table e (& a b))) :ruleset truth-table)
(rule ((= e (Or x y)) (= a (lanes x)) (= b (lanes y)))
      ((word-table e (| a b))) :ruleset truth-table)
(rule ((= e (Xor x y)) (= a (lanes x)) (= b (lanes y)))
      ((word-table e (^ a b))) :ruleset truth-table)
(rule ((= e (Not x)) (= a (lanes x)))
      ((word-table e (^ a -1))) :ruleset truth-table)
(rule ((= e (Bw p x)) (= mask (lanes (Bw p (Num -1)))) (= a (lanes x)))
      ((word-table e (& a mask))) :ruleset truth-table)
