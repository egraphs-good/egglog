; Append to theory.egg and execute with the raw Lean interpreter.
(push)
(let $p (Var "p"))
(let $q (Var "q"))
(let $r (Var "r"))
(let $x (Var "x"))
(let $y (Var "y"))
(width $p)
(width $q)
(width $r)
(lt $p $q)
(lt $q $r)
(let $lo (Bw $p $x))
(let $small (Bw $p (Bw $r $x)))
(let $sum (Add $lo (Bw $p $y)))
(let $exact (Bw $q $sum))
(let $signed (Signed $q $lo))
(let $diff (Sub $lo (Bw $p $y)))
(let $signedDiff (Signed $q $diff))
(let $wide (Bw $r $x))
(run 14)
(check (lt $p $r) (le $p $p) (fits $sum $q) (sign-fits $diff $q))
(check (= $small $lo) (= $exact $sum) (= $signed $lo) (= $signedDiff $diff))
(fail (check (= $wide $lo)))
(fail (check (= (Signed $p $lo) $lo)))
(pop)

(push)
(fail (check (= (<< 1 64) 0)))
(fail (check (= (/ -9223372036854775808 -1) 0)))
(let $a (Bw (Num 8) (Neg (Num 1))))
(let $b (Shr (Num -11) (Num 1)))
(let $c (Xor (Num 12) (Num -1)))
(let $overflow (Add (Num 9223372036854775807) (Num 1)))
(run 10)
(check (= (constant $a) 255) (= (constant $b) -6) (= (constant $c) -13))
(fail (check (constant $overflow)))
(pop)

(push)
(let $x (Var "x"))
(let $y (Var "y"))
(let $w (Var "w"))
(atom-index $x 0)
(atom-index $y 1)
(atom-index (Bw $w (Num -1)) 2)
(let $l (Bw $w (Xor $x (And $x $y))))
(let $r (Bw $w (And $x (Not $y))))
(let $wrong (Bw $w (Or $x (Not $y))))
(push)
(run truth-table 40 :until (= $l $r))
(check (= $l $r))
(fail (check (= $r $wrong)))
(pop)
(run bdd 160 :until (= $l $r))
(check (= $l $r))
(fail (check (= $r $wrong)))
(pop)

(push)
(atom-index (Var "x") 7)
(atom-index (Var "y") 7)
(fail (run bdd 1))
(pop)

; Hydra opt_310 and opt_2703 at q = 2, r = 3, t = 4, newvar0 = 1.
; Strict width ordering holds in both. The published formulas give distinct
; residues at this valuation.
(push)
(let $q (Num 2))
(let $r (Num 3))
(let $t (Num 4))
(let $x (Num 1))
(let $l310 (Bw $r (Sub (Bw $r (Num 0)) (Bw $r (Bw $q $x)))))
(let $r310 (Bw $r (Signed $q (Bw $q $x))))
(let $l2703 (Bw $t (Signed $r (Bw $r (Sub (Bw $r (Num 0)) (Bw $r (Bw $q $x)))))))
(let $r2703 (Bw $t (Signed $q (Bw $q $x))))
(run 12)
(check (= (constant $l310) 7) (= (constant $r310) 1))
(check (= (constant $l2703) 15) (= (constant $r2703) 1))
(fail (check (= $l310 $r310)))
(fail (check (= $l2703 $r2703)))
(pop)

; Atom 6 falls outside the packed table. It remains unconstrained there.
(push)
(atom-index (Var "x") 0)
(atom-index (Var "y") 6)
(let $x (Var "x"))
(let $y (Var "y"))
(let $masked (Or (And $x $y) (And $x (Not $y))))
(run truth-table 40)
(fail (check (= $x $masked)))
(run bdd 160 :until (= $x $masked))
(check (= $x $masked))
(fail (check (= $x $y)))
(pop)
