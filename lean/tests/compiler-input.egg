(datatype* (Term (Ref Vector) (Lit f64) (Flag bool)) (Vector (Cons Term Vector) (Nil)))
(function seen (bool) Term :merge new)
(relation active (Term))
(constructor Wrap (Term) Term)
(let answer (Lit -1.0))
(let flag (Flag true))
(let linked (Ref (Cons answer (Nil))))
(rule ((Ref items) (= items (Cons x (Nil))))
      ((let result (Wrap x)) (set (seen true) result) (active result))
      :name "reachable literal")
(run 2)
(check (= (seen true) (Wrap (Lit -1.000000))))
(check (active (Wrap answer)))
(check (!= true false))
(Lit 0.0)
(Lit 1.0)
(Lit 1.0000000000000002)
(check (= (Lit -0.0) (Lit 0.0)))
(check (= (Lit 1.0000000000000002) (Lit 1.00000000000000022)))
(check (!= (Lit 1.0000000000000002) (Lit 1.0)))

(datatype E0 (Zero))
(Zero)
