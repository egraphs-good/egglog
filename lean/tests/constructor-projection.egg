(datatype E (Leaf i64) (Pair E E))
(relation #constructor-row-1-2 (E))
(relation reached (E))
(relation seen (E))
(ruleset walk)
(rule ((= p (Pair x x))) ((reached (Pair x x))) :ruleset walk)
(rule ((reached p) (= p (Pair l r))) ((reached l) (seen r)) :ruleset walk)
(let $a (Leaf 1))
(let $b (Leaf 2))
(let $aa (Pair $a $a))
(let $ab (Pair $a $b))
(#constructor-row-1-2 $b)
(run-schedule (saturate (run walk :until (seen $a))))
(check (seen $a) (reached $aa) (reached $a) (#constructor-row-1-2 $b))
(fail (check (reached $ab)))
(fail (check (#constructor-row-1-2 $a)))
(union $a $b)
(run-schedule (saturate walk))
(check (reached $ab) (seen $b))
