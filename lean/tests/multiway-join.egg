(datatype Expr (Lit i64) (Add Expr Expr))
(relation edge (Expr Expr))
(relation seed (Expr Expr))
(relation triangle (Expr Expr Expr))
(relation marked (Expr))
(relation loop (Expr))
(relation symmetric (Expr Expr))
(relation weight-triangle (Expr i64))
(function weight (Expr) i64 :merge (min old new))

(rule ((seed x y)) ((edge x y)))
(rule ((edge x y) (edge y z) (edge z x)) ((triangle x y z)))
(rule ((triangle a (Add x x) c) (edge c a) (marked x)) ((loop x)))
(rule ((triangle x y z) (= n (weight z)) (marked y)) ((weight-triangle x n)))
(rule ((edge x y) (edge y x) (marked y)) ((symmetric x y)))

(let $a (Lit 0))
(let $b (Lit 1))
(let $c (Lit 2))
(let $sum (Add $b $b))
(seed $a $sum)
(seed $sum $c)
(seed $c $a)
(seed $a $b)
(seed $b $a)
(marked $b)
(marked $sum)
(set (weight $c) 7)
(run 4)
(check (triangle $a $sum $c) (symmetric $a $b) (loop $b) (weight-triangle $a 7))
(fail (check (triangle $a $b $c)))
(fail (check (loop $a)))

; Different repeated-column constraints on the same table need distinct views.
(relation feed (i64 i64 i64))
(relation triples (i64 i64 i64))
(relation member (i64))
(relation samePrefix (i64 i64))
(relation sameSuffix (i64 i64))
(rule ((feed fa fb fc)) ((triples fa fb fc)))
(rule ((member x) (triples x x y) (member y)) ((samePrefix x y)))
(rule ((member u) (triples u v v) (member v)) ((sameSuffix u v)))
(member 1) (member 2) (member 3)
(feed 1 1 2) (feed 2 3 3)
(run 2)
(check (samePrefix 1 2) (sameSuffix 2 3))
(fail (check (samePrefix 2 3)))
(fail (check (sameSuffix 1 2)))
