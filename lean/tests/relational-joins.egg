(relation leftRow (i64 i64 i64))
(relation seedRight (i64 i64 i64))
(relation rightRow (i64 i64 i64))
(relation joined (i64 i64 i64))
(relation previous (i64))
(relation crossOut (i64 i64))
(relation fallbackOut (i64 i64))
(relation unitRow ())
(rule ((seedRight a b c)) ((rightRow a b c)))
; Repeated column within the left atom, two shared columns, projected right field.
(rule ((leftRow a b a) (rightRow b x a)) ((joined a x b)))
; No join key; projecting fields on either side of a cross product.
(rule ((previous x) (rightRow a b c)) ((crossOut x c)))
; Three body atoms take the generic semi-naive matcher.
(rule ((previous x) (leftRow a b a) (rightRow b y a)) ((fallbackOut x y)))
(rule ((joined a x b)) ((unitRow)))
(leftRow 2 3 2)
(leftRow 4 3 1)
(seedRight 3 5 2)
(seedRight 3 7 8)
(previous 9)
(push)
(run 1)
(fail (check (joined 2 5 3)))
(pop)
(run 4)
(check (joined 2 5 3) (crossOut 9 2) (crossOut 9 8) (fallbackOut 9 5) (unitRow))
(fail (check (joined 2 7 3)))
(fail (check (joined 4 5 3)))
