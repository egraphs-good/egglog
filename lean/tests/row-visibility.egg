(datatype Term (A) (B) (C) (F Term) (Wrap Term))
(relation hit (Term))
(ruleset probe)
(rule ((F x)) ((hit x)) :ruleset probe)
(let $old (F (A)))
(F (B))
(subsume (F (A)))
(run probe 1)
(check (hit (B)))
(fail (check (hit (A))))
(check (= $old (F (A))))
(union (A) (B))
(relation after-merge (Term))
(rule ((F x)) ((after-merge x)))
(run 1)
(fail (check (after-merge (A))))
(let $w (Wrap $old))
(delete (F (A)))
(let $fresh (F (A)))
(fail (check (= $fresh $old)))
(run 1)
(check (after-merge (A)))
(check (= $w (Wrap $old)))

(function lookup (Term) Term :merge new)
(set (lookup (C)) $fresh)
(rule ((= x (lookup (C)))) ((delete (lookup (C)))) :ruleset probe)
(run probe 1)
(fail (check (lookup (C))))

; Snapshot keys matter when two classes merge earlier in a rule head.
(datatype Key (K1) (K2) (G Key))
(let $left (G (K1)))
(let $right (G (K2)))
(ruleset remove-right)
(rule ((= a (K1)) (= b (K2)) (= f (G b)))
      ((union a b) (delete (G b))) :ruleset remove-right)
(run remove-right 1)
(check (= (G (K1)) $left))
(fail (check (= $left $right)))
