(datatype Key (A) (B))
(relation active (Key))
(relation merge-pair (Key Key))
(relation seen (i64))
(function weight (Key) i64 :merge (min old new))
(function result (Key) i64 :merge (max old new))
(function first () i64 :merge old)
(function last () i64 :merge new)

(set (first) 9)
(set (first) 3)
(set (last) 9)
(set (last) 3)
(check (= (first) 9) (= (last) 3))

(set (weight (A)) 4)
(set (weight (B)) -7)
(active (A))
(rule ((active k) (= n (weight k))) ((set (result k) (+ n 1))))
(rule ((= n (result k))) ((seen n)))
(rule ((merge-pair x y)) ((union x y)))

(run 3)
(check (= (result (A)) 5) (seen 5))
(merge-pair (A) (B))
(run 4)
(check (= (weight (B)) -7) (= (result (B)) 5))
(check (active (B)))
(set (result (A)) 12)
(run 2)
(check (seen 12))

(relation tagged (i64))
(push)
(ruleset tag)
(rule ((seen n)) ((tagged n)) :ruleset tag)
(run 1)
(fail (check (tagged 12)))
(run-schedule (seq (repeat 2 (run tag :until (tagged 12)))))
(check (tagged 12))
(pop)
(fail (check (tagged 12)))

; The resident key supplies old even when a later key was inserted first.
(datatype K (X) (Y))
(X)
(Y)
(function keep (K) i64 :merge old)
(function keep-new (K) i64 :merge new)
(set (keep (Y)) 20)
(set (keep-new (Y)) 20)
(set (keep (X)) 10)
(set (keep-new (X)) 10)
(union (Y) (X))
(check (= (keep (Y)) 10) (= (keep-new (X)) 20))
